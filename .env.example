# God Watch environment variables.
# Copy to `.env` for local development. Never commit real values.

# Public URL of the app (used for metadata, sitemap and robots).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js. Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorised redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Neon Postgres.
# DATABASE_URL: pooled connection string (host contains "-pooler"), used by the app.
# DIRECT_URL:   direct connection string, used by Prisma migrations.
DATABASE_URL=
DIRECT_URL=

# Only for the one-off copy from the legacy Supabase database (npm run db:copy-legacy).
# SOURCE_DATABASE_URL=
