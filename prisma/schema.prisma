// ============================================================
// God Watch — Prisma schema (Neon PostgreSQL)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------
// Auth.js models (Google OAuth)
// ------------------------------------------------------------

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  tasks            Task[]
  notes            Note[]
  activityLogs     ActivityLog[]
  userAchievements  UserAchievement[]
  settings          Settings?
  pushSubscriptions PushSubscription[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------------------------------
// Domain models
// ------------------------------------------------------------

/// A user-defined habit / checklist item.
model Task {
  id         String   @id @default(cuid())
  userId     String
  name       String
  color      String   @default("#6366f1")
  order      Int      @default(0)
  /// First day the habit counts, in the user's timezone (yyyy-MM-dd).
  startDate  String
  /// Day the habit was archived (yyyy-MM-dd); it stops counting from this day. Null while active.
  archivedOn String?
  /// Optional per-weekday time windows: { "0".."6" (Sun..Sat): { start: "HH:mm", end: "HH:mm" } }.
  times      Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskStatuses TaskStatus[]

  @@index([userId, archivedOn, order])
}

/// A device registered for Web Push ("habit starts now" alerts).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Dedupe marker so each habit-start push is sent once per day.
model SentPush {
  key    String   @id
  sentAt DateTime @default(now())

  @@index([sentAt])
}

enum Status {
  PENDING
  COMPLETED
  FAILED
  MISSED
}

/// One cell in the grid: status of a task on a particular date.
/// `date` is a calendar day in the user's timezone (yyyy-MM-dd).
model TaskStatus {
  id        String   @id @default(cuid())
  taskId    String
  date      String
  status    Status   @default(PENDING)
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, date])
  @@index([date])
  @@index([taskId])
}

/// Autosaved note attached to a specific date.
model Note {
  id        String   @id @default(cuid())
  userId    String
  date      String
  content   String   @db.Text @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

enum ActivityType {
  TASK_CREATED
  TASK_RENAMED
  TASK_DELETED
  TASK_ARCHIVED
  TASK_UNARCHIVED
  TASK_REORDERED
  TASK_COLOR_CHANGED
  STATUS_CHANGED
  LOGIN
  LOGOUT
  SETTINGS_CHANGED
  NOTE_UPDATED
  ACHIEVEMENT_UNLOCKED
}

/// Full audit trail of user actions.
model ActivityLog {
  id        String       @id @default(cuid())
  userId    String
  type      ActivityType
  metadata  Json? // flexible context: {taskId, date, from, to, noteId, ...}
  ip        String?
  userAgent String?      @db.Text
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
}

/// Badges / achievements definitions.
model Achievement {
  id               String            @id @default(cuid())
  key              String            @unique
  name             String
  description      String
  icon             String
  criteria         Json // {type: "STREAK_DAYS"|"TOTAL_COMPLETED"|..., value: number}
  createdAt        DateTime          @default(now())

  userAchievements UserAchievement[]
}

/// User's unlocked achievements.
model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

/// Per-user preferences.
model Settings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  /// IANA timezone that defines the user's "today".
  timeZone             String   @default("UTC")
  dailyReminderEnabled Boolean  @default(false)
  dailyReminderTime    String   @default("20:00") // HH:mm local
  defaultTaskColor     String   @default("#6366f1")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Fixed-window rate-limit counters, shared by every server instance.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
